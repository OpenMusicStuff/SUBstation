{
    "name": "Ableton Live",
    "bindings": {
        "newProject": ["Ctrl+N"],
        "openProject": ["Ctrl+O"],
        "save": ["Ctrl+S"],
        "saveAs": ["Ctrl+Shift+S"],
        "exportAudio": ["Ctrl+Shift+R"],
        "quit": ["Ctrl+Q"],
        "undo": ["Ctrl+Z"],
        "redo": ["Ctrl+Y", "Ctrl+Shift+Z"],
        "cut": ["Ctrl+X"],
        "copy": ["Ctrl+C"],
        "paste": ["Ctrl+V"],
        "duplicate": ["Ctrl+D"],
        "rename": ["Ctrl+R"],
        "split": ["Ctrl+E"],
        "consolidate": ["Ctrl+J"],
        "reverseClips": ["R"],
        "toggleClipActivation": ["0"],
        "freeze": ["Ctrl+Shift+F"],
        "delete": ["Del", "Backspace"],
        "selectAll": ["Ctrl+A"],
        "soloSelectedTracks": ["S"],
        "playStop": ["Space"],
        "record": ["F9"],
        "goToStart": ["Home"],
        "loop": ["Ctrl+L"],
        "findInBrowser": ["Ctrl+F"],
        "insertAudioTrack": ["Ctrl+T"],
        "insertMidiTrack": ["Ctrl+Shift+T"],
        "insertReturnTrack": ["Ctrl+Alt+T"],
        "insertMidiClip": ["Ctrl+Shift+D", "Ctrl+Shift+M"],
        "groupTracks": ["Ctrl+G"],
        "ungroupTracks": ["Ctrl+Shift+G"],
        "browser": ["Ctrl+Alt+B"],
        "fileManager": ["Ctrl+Alt+F"],
        "agentChangesView": ["Ctrl+Alt+A"],
        "deviceView": ["Ctrl+Alt+L"],
        "clipView": ["Shift+Tab"],
        "findTrack": ["Q"],
        "automation": ["A"],
        "inOut": ["Ctrl+Alt+I"],
        "showHarmony": ["C"],
        "closePluginEditor": ["Ctrl+W"],
        "reopenPluginEditor": ["Ctrl+Shift+W"],
        "zoomIn": ["+", "=", "Ctrl++"],
        "zoomOut": ["-", "Ctrl+-"],
        "zoomToArrangement": ["Z"],
        "narrowGrid": ["Ctrl+1"],
        "widenGrid": ["Ctrl+2"],
        "snapToGrid": ["Ctrl+4"],
        "preferences": ["Ctrl+,"],
        "computerMidiKeyboard": ["M"]
    }
}
